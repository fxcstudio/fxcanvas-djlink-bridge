<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>studio.fxc</groupId>
  <artifactId>fxc-djlink-bridge</artifactId>
  <version>1.4.0</version>
  <packaging>jar</packaging>

  <name>FXCanvas DJ Link Bridge</name>
  <description>Bridges Pro DJ Link data (tempo, beats, metadata, phrase analysis) to OSC for FXCanvas.</description>

  <licenses>
    <license>
      <name>Eclipse Public License 2.0</name>
      <url>https://www.eclipse.org/legal/epl-2.0/</url>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- CDJ-3000X support is only on beat-link main (8.1.0 preview). Both are pinned
         to timestamped snapshot builds, not the moving -SNAPSHOT, so a build is
         reproducible: beat-link main at 1483c006 (2026-10-27), and the crate-digger
         snapshot it was built against. Move to 8.1.0 once it is released. -->
    <beatlink.version>8.1.0-20261027.135635-6</beatlink.version>
    <cratedigger.version>0.2.2-20261026.025444-2</cratedigger.version>
    <sqlite-jdbc.version>3.50.1.0</sqlite-jdbc.version>
    <slf4j.version>1.7.36</slf4j.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <repositories>
    <repository>
      <!-- Deep Symmetry publishes beat-link and crate-digger previews here. -->
      <id>central-snapshots</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
      <releases><enabled>false</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <!-- beat-link's pom asks for crate-digger 0.2.2-SNAPSHOT; pin the build instead. -->
      <dependency>
        <groupId>org.deepsymmetry</groupId>
        <artifactId>crate-digger</artifactId>
        <version>${cratedigger.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.willena</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite-jdbc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.deepsymmetry</groupId>
      <artifactId>beat-link</artifactId>
      <version>${beatlink.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}-${project.version}-thin</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>studio.fxc.djlink.Main</mainClass>
            </manifest>
            <manifestEntries>
              <Implementation-Title>fxc-djlink-bridge</Implementation-Title>
              <Implementation-Version>${project.version}</Implementation-Version>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/${project.artifactId}-${project.version}.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <!-- beat-link reads the encrypted SQLite export (exportLibrary.db) of
                       CDJ-3000X, XDJ-AZ and Opus Quad players through sqlite-jdbc when a
                       database key is set. The bridge never sets one, but beat-link loads
                       it from the shared Java preferences (for example one saved by Beat
                       Link Trigger). Keep the natives for the platforms FXCanvas ships on
                       (Windows x64, macOS arm64 and x64) and drop the rest (~12 MB).
                       The macOS dylibs are unsigned: the app build must sign them. -->
                  <artifact>io.github.willena:sqlite-jdbc</artifact>
                  <excludes>
                    <exclude>org/sqlite/native/FreeBSD/**</exclude>
                    <exclude>org/sqlite/native/Linux/**</exclude>
                    <exclude>org/sqlite/native/Linux-Android/**</exclude>
                    <exclude>org/sqlite/native/Linux-Musl/**</exclude>
                    <exclude>org/sqlite/native/Windows/aarch64/**</exclude>
                    <exclude>org/sqlite/native/Windows/armv7/**</exclude>
                    <exclude>org/sqlite/native/Windows/x86/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>studio.fxc.djlink.Main</mainClass>
                  <manifestEntries>
                    <Implementation-Title>fxc-djlink-bridge</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- Source jars of every bundled dependency, for third-party-sources.zip (LGPL/EPL source availability). -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>third-party-sources</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <classifier>sources</classifier>
              <includeScope>runtime</includeScope>
              <failOnMissingClassifierArtifact>false</failOnMissingClassifierArtifact>
              <outputDirectory>${project.build.directory}/third-party-sources</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
